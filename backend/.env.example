# Copy this file to .env (never commit .env).
#
# Running with `docker compose up` (default): the backend reaches Postgres
# through the compose service name "db", with the credentials set in docker-compose.yml.
DATABASE_URL=postgresql+psycopg2://cloudtrace:cloudtrace@db:5432/cloudtrace

# Running uvicorn directly on your PC instead? Use localhost, not db:
# DATABASE_URL=postgresql+psycopg2://cloudtrace:cloudtrace@localhost:5432/cloudtrace

# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=replace-this-with-a-random-generated-value

# First admin account, created automatically on startup if no admin exists yet.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-this-password

# Optional: max upload size in MB (default 50)
# MAX_UPLOAD_MB=50

# Comma-separated list of browser origins allowed to call the API (default: http://localhost:3000)
# CORS_ORIGINS=http://localhost:3000

# --- Evidence storage -------------------------------------------------------
# "local" keeps files on disk (development). "s3" stores them in your bucket.
STORAGE_BACKEND=local
# Only needed when STORAGE_BACKEND=s3. Use the access key of the scoped
# "cloudtrace-app" IAM user, never an administrator key.
# S3_BUCKET_NAME=your-bucket-name
# AWS_REGION=ap-south-1
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
