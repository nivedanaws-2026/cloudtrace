# Local development — copy this file to .env and keep .env out of git
# Host is "db" (the compose service name) when the backend runs in a container.
DATABASE_URL=postgresql+psycopg2://cloudtrace:cloudtrace@db:5432/cloudtrace

# Generate a real random value for this — e.g. run: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=replace-this-with-a-random-generated-value

# Used once at startup to bootstrap the first admin account (see app/main.py).
ADMIN_EMAIL=admin@cloudtrace.local
ADMIN_PASSWORD=change-me-before-you-run
