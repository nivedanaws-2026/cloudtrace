# Local development — copy this file to .env and keep .env out of git
DATABASE_URL=postgresql+psycopg2://cloudtrace_user:devpass@localhost:5432/cloudtrace

# Generate a real random value for this — e.g. run: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=replace-this-with-a-random-generated-value
